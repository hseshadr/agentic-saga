# Copy this file to .env. Never commit .env or paste a real key into this template.
OPENROUTER_API_KEY=

# Optional: direct TypeSafe AI Jev route. OpenRouter Decisions reuses OPENROUTER_API_KEY.
TYPESAFE_API_KEY=

# Live evaluation also requires explicit consent. Leave disabled until you intend to spend money.
RUN_LIVE_MODEL_EVALS=0

# Local Temporal development defaults. Production deployments should inject their own endpoint,
# namespace, TLS, and authenticated client configuration.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
